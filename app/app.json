{
  "expo": {
    "name": "Sentorin",
    "slug": "sentorin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sentorin.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Sentorin uses Bluetooth to find your pen when it is nearby.",
        "NSLocationWhenInUseUsageDescription": "Sentorin saves where your pen was last seen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sentorin.app",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "sentorin",
    "plugins": [
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sentorin saves where your pen was last seen."
        }
      ]
    ]
  }
}